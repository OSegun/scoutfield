# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.ipynb_checkpoints/

# ------------------------------------------------- generated, never hand-edited
# Rule: if a script wrote it, nobody edits it by hand. Fix the code or the data
# and re-run.
#
# Generated does not mean untracked. Summaries, sweep CSVs and figures ARE
# tracked, as they are in the pilot: docs/RESULTS.md quotes numbers from them, and
# a reader who cannot open the file the number came from has to take the document
# on trust. Weights stay out — they are large and live on Kaggle.
results/**
!results/.gitkeep
!results/*.json
!results/*.csv
figures/**
!figures/.gitkeep
!figures/*.png
checkpoints/**
!checkpoints/.gitkeep
runs/
wandb/
tensorboard/

# ------------------------------------------------------ data and weights
# PlantVillage / PlantDoc are pulled at run time, never vendored.
data/
*.pt
*.pth
*.onnx
*.ckpt
*.npz
*.h5

# -------------------------------------------------------------- tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
kaggle.json
.DS_Store
